# Field Desk — production env (copy to ops/.env and fill in). Compose reads these.
# Postgres
POSTGRES_USER=agf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agf
# App DB URL (points at the postgres service)
AGF_DATABASE_URL=postgresql://agf:change-me@postgres:5432/agf
# MinIO / S3
MINIO_ROOT_USER=agf
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://minio:9000
S3_BUCKET=agf
# Residential rotating proxies (newline/comma list of user:pass@host:port) — §3.10
AGF_PROXIES=
