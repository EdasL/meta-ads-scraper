# Field Desk API (Go) — local config. Copy to .env for `go run .` / godotenv.
# These are the SAME variables the Python service uses, so both runtimes share
# one Postgres and one MinIO/S3 endpoint.

# Postgres. A SQLAlchemy-style URL (postgresql+psycopg://) is accepted — the Go
# config strips the +psycopg driver suffix automatically.
AGF_DATABASE_URL=postgres://agf:agf@localhost:5432/agf?sslmode=disable

# Browser origins allowed to call the API (comma-separated).
AGF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTP port (compose maps 8000:8000).
PORT=8000

# MinIO / S3 (media proxy). Same names as src/agf/storage/s3.py.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agf
S3_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Set GIN_MODE=release in production to quiet gin's debug logging.
# GIN_MODE=release

# Optional error tracking. Leave SENTRY_DSN empty to disable (no-op).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional bearer token guarding the write endpoint (POST review decision).
# Leave empty to disable auth (the default). When set, the client must send
# `Authorization: Bearer <token>` on writes — coordinate with the web app first.
# AGF_API_TOKEN=
